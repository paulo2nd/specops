{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specops.dev/schemas/doctor-output-v1.json",
  "title": "SpecOps doctor output (v1)",
  "description": "Versioned machine-readable output of `specops doctor --json`. Consumers MUST tolerate unknown `domain` ids and unknown `next_action_code` values (forward-compatible, additive growth).",
  "type": "object",
  "required": ["command", "output_version", "outcome", "class", "verdict", "domains"],
  "additionalProperties": true,
  "properties": {
    "command": { "const": "doctor" },
    "output_version": { "type": "integer", "const": 1 },
    "outcome": { "type": "string", "enum": ["ok", "blocked", "error"] },
    "class": { "type": "string", "enum": ["pass", "gate-rejection", "infra-error"] },
    "verdict": { "$ref": "#/$defs/severity" },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainResult" }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["ok", "warning", "blocking", "execution-error"]
    },
    "finding": {
      "type": "object",
      "required": ["severity", "message", "next_action_code", "next_action", "id"],
      "additionalProperties": true,
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" },
        "next_action_code": {
          "type": "string",
          "description": "Stable machine-actionable code. `none` iff severity is `ok`. New values may be added in a later release without a version bump.",
          "examples": [
            "none", "initialize_repository", "install_specops", "upgrade_cli",
            "run_specify_check", "run_specify_workflow_status", "migrate_legacy_install",
            "fix_config", "start_or_select_feature", "resolve_identity_conflict",
            "run_status_migrate", "ledger_schema_unsupported", "fix_context_map",
            "refresh_context_provenance", "reconcile_repository", "install_gate_command",
            "fix_gate_profiles", "verify_blocking_findings", "repair_unreadable_input"
          ]
        },
        "next_action": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "domainResult": {
      "type": "object",
      "required": ["domain", "severity", "findings"],
      "additionalProperties": true,
      "properties": {
        "domain": {
          "type": "string",
          "description": "Fixed, ordered domain id. New domains may be added without a version bump.",
          "examples": [
            "environment", "cli_extension", "integration", "legacy_artifacts",
            "configuration", "feature_identity", "ledger", "context_map",
            "workflow_divergence", "gate_availability"
          ]
        },
        "severity": { "$ref": "#/$defs/severity" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  }
}
